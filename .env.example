EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public VAPID key used by browsers to create Web Push subscriptions.
EXPO_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# EAS file-secret path to the Firebase config used only while building Android.
GOOGLE_SERVICES_JSON=

# --- Build/deploy-injected vars (not meant to be set by hand in local .env; ---
# --- documented here so their purpose isn't a mystery when you see them referenced) ---
# CI/build-injected git commit SHA, shown in the app's release/diagnostics info.
EXPO_PUBLIC_COMMIT_SHA=
# CI/build-injected release channel name, shown in the app's release/diagnostics info.
EXPO_PUBLIC_RELEASE_CHANNEL=
# Shared secret the Vercel cron endpoint (api/cron/execute-recurring.js) checks
# on incoming requests, set as a Vercel deployment env var, not local .env.
CRON_SECRET=
# Server-side Supabase URL used by api/cron/execute-recurring.js -- distinct from
# the client-side EXPO_PUBLIC_SUPABASE_URL above, set as a Vercel deployment env var.
SUPABASE_URL=
